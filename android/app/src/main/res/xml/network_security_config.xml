<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The chat host (chatbot-api.epfassist.com) serves a publicly trusted
         Let's Encrypt cert over HTTPS and redirects HTTP -> HTTPS, so no
         self-signed trust anchor or cleartext exception is needed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
